{
  "info": {
    "name": "JUPEB Portal - Finance (Receipts & Reconciliation)",
    "_postman_id": "8a32d184-5f33-4f51-b021-998fce2b8102",
    "description": "Postman collection for Institution Payment Receipts, Reconciliation, Status Management, and Platform Auditing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://reg-portal-api.morgengreen.cloud",
      "type": "string"
    },
    {
      "key": "institutionToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "e4b2d358-18e5-420a-9fc9-0b1a136cf982",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Upload Institution Payment Receipt (Multipart)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{institutionToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "description": "Receipt document (PDF, PNG, JPG)"
            },
            {
              "key": "payment_item_id",
              "value": "fee_affiliation",
              "type": "text"
            },
            {
              "key": "amount",
              "value": "500000",
              "type": "text"
            },
            {
              "key": "payment_structure_id",
              "value": "struct_full",
              "type": "text"
            },
            {
              "key": "transaction_ref",
              "value": "TEL-20261002-9941",
              "type": "text"
            },
            {
              "key": "bank_name",
              "value": "Wema Bank (JUPEB Central)",
              "type": "text"
            },
            {
              "key": "payment_date",
              "value": "2026-10-02",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Affiliation fee payment for 2026/2027 session",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/finance/institution/upload-receipt",
          "host": ["{{baseUrl}}"],
          "path": ["finance", "institution", "upload-receipt"]
        },
        "description": "Allows university institution user to upload bank receipt document and fee breakdown for verification."
      }
    },
    {
      "name": "2. Confirm or Update Payment Status (Finance Officer)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"successful\",\n  \"confirmed_amount\": 500000,\n  \"reconciliation_ref\": \"REC-WEMA-9921\",\n  \"notes\": \"Bank statement credit verified against Central account.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/finance/admin/payments/{{paymentId}}/confirm",
          "host": ["{{baseUrl}}"],
          "path": ["finance", "admin", "payments", "{{paymentId}}", "confirm"]
        },
        "description": "Finance Officer approves or rejects submitted payment with ledger reconciliation reference."
      }
    },
    {
      "name": "3. Cancel Pending Institution Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{institutionToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/finance/institution/payments/{{paymentId}}/cancel",
          "host": ["{{baseUrl}}"],
          "path": ["finance", "institution", "payments", "{{paymentId}}", "cancel"]
        },
        "description": "Marks a pending institution payment attempt as cancelled."
      }
    },
    {
      "name": "4. List Institution Payment Transactions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{institutionToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/finance/institution/payments?page=1&limit=20&status=successful",
          "host": ["{{baseUrl}}"],
          "path": ["finance", "institution", "payments"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" },
            { "key": "status", "value": "successful" }
          ]
        },
        "description": "Retrieves fee transactions for the authenticated university."
      }
    },
    {
      "name": "5. Get Institution Payment Receipt",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{institutionToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/finance/institution/payments/{{paymentId}}/receipt",
          "host": ["{{baseUrl}}"],
          "path": ["finance", "institution", "payments", "{{paymentId}}", "receipt"]
        },
        "description": "Retrieves finalized receipt voucher data for an institution transaction."
      }
    },
    {
      "name": "6. Admin: List All Payments (Platform Search)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/finance/payments?page=1&limit=20&q=&status=successful",
          "host": ["{{baseUrl}}"],
          "path": ["finance", "payments"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" },
            { "key": "q", "value": "" },
            { "key": "status", "value": "successful" }
          ]
        },
        "description": "Global search and audit across all student and institution payments."
      }
    }
  ]
}
