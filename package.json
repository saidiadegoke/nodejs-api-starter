{
  "name": "node-api-template",
  "version": "1.0.0",
  "description": "Node.js + Express + PostgreSQL API starter template with JWT auth, RBAC, file uploads, notifications, WebSocket, and Swagger docs.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "clear-db": "node scripts/clear-db.js",
    "test": "NODE_ENV=test jest --coverage --runInBand",
    "test:auth": "NODE_ENV=test jest src/tests/auth.api.test.js --runInBand",
    "test:rbac": "NODE_ENV=test jest src/tests/rbac.test.js --runInBand",
    "test:assets": "NODE_ENV=test jest src/tests/assets.test.js --runInBand",
    "test:payments": "NODE_ENV=test jest src/tests/payments.api.test.js --runInBand",
    "test:posts": "NODE_ENV=test jest src/tests/posts.api.test.js --runInBand",
    "test:jupeb": "NODE_ENV=test jest src/tests/jupeb.catalog.utils.test.js src/tests/jupeb.catalog.api.test.js src/tests/jupeb.sessions.utils.test.js src/tests/jupeb.sessions.api.test.js src/tests/jupeb.identity.utils.test.js src/tests/jupeb.identity.api.test.js src/tests/jupeb.submission.utils.test.js src/tests/jupeb.submission.api.test.js src/tests/jupeb.registration.utils.test.js src/tests/jupeb.registration.api.test.js src/tests/jupeb.finance.utils.test.js src/tests/jupeb.finance.api.test.js src/tests/jupeb.academic.utils.test.js src/tests/jupeb.academic.api.test.js src/tests/jupeb.institution-scope.api.test.js --runInBand",
    "test:mobile": "NODE_ENV=test jest src/tests/integrations.providers.test.js src/tests/mobile.dashboard.attendance.api.test.js src/tests/mobile.settings.registration.api.test.js --runInBand",
    "test:ocr": "NODE_ENV=test jest src/tests/ocr.parsers.test.js src/tests/ocr.providers.test.js src/tests/ocr.api.test.js --runInBand",
    "test:reg": "NODE_ENV=test jest src/tests/auth.code-status.api.test.js src/tests/auth.register-with-code.api.test.js src/tests/jupeb.next-of-kin.api.test.js src/tests/jupeb.registration.profile-edit.api.test.js src/tests/jupeb.submission.source-sitting.api.test.js src/tests/jupeb.submission.ocr-trigger.api.test.js src/tests/jupeb.result-entries.api.test.js src/tests/jupeb.registration.pdf.api.test.js src/tests/jupeb.submission.download-url.api.test.js src/tests/jupeb.identity.write-through.api.test.js src/tests/jupeb.result-entries.review.api.test.js src/tests/jupeb.registration.institution-list.api.test.js src/tests/jupeb.registration.batch-actions.api.test.js src/tests/mobile.settings.registration.api.test.js --runInBand",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:verbose": "NODE_ENV=test jest --verbose --runInBand",
    "test:cleanup": "node src/tests/test-db-cleanup.js",
    "db:clear": "node scripts/clear-db.js",
    "universities:clear": "node scripts/clear-universities.js",
    "rbac": "node scripts/rbac.js",
    "rbac:setup": "node scripts/rbac.js setup-common",
    "rbac:create-role": "node scripts/create-role.js",
    "rbac:create-permission": "node scripts/create-permission.js",
    "rbac:add-permission-to-role": "node scripts/add-permission-to-role.js",
    "rbac:add-role-to-user": "node scripts/add-role-to-user.js",
    "rbac:list-user-roles": "node scripts/list-user-roles.js",
    "rbac:list-role-permissions": "node scripts/list-role-permissions.js",
    "rbac:set-user-password": "node scripts/set-user-password.js",
    "sso:generate-keys": "node scripts/generate-sso-keys.js",
    "openapi:generate": "node scripts/generate-openapi.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saidiadegoke/nodejs-api-starter.git"
  },
  "bugs": {
    "url": "https://github.com/saidiadegoke/nodejs-api-starter/issues"
  },
  "homepage": "https://github.com/saidiadegoke/nodejs-api-starter#readme",
  "keywords": [
    "express",
    "postgresql",
    "api",
    "starter",
    "template",
    "jwt",
    "rbac",
    "authentication",
    "swagger",
    "openapi",
    "websocket",
    "s3"
  ],
  "author": "Saidi Adegoke <rasheedsaidi@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.948.0",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.0",
    "helmet": "^7.1.0",
    "joi": "^18.0.2",
    "jose": "^4.15.9",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nanoid": "^3.3.11",
    "nodemailer": "^8.0.6",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-twitter": "^0.1.5",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.0.379",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.3",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^5.1.1",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
