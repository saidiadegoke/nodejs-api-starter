{
  "name": "reg-portal-api",
  "version": "1.0.0",
  "description": "Registration Portal NestJS API",
  "main": "dist/main.js",
  "scripts": {
    "prestart": "npm run build",
    "start": "node dist/main.js",
    "start:dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node -r tsconfig-paths/register' src/main.ts",
    "prestart:prod": "npm run build",
    "start:prod": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "build:prod": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "migrate": "ts-node -r tsconfig-paths/register src/database/migrate.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/run-seed.ts",
    "clear-db": "node scripts/clear-db.js",
    "db:clear": "node scripts/clear-db.js",
    "universities:clear": "node scripts/clear-universities.js",
    "email:check": "node scripts/check-email.js",
    "email:test-otp": "node scripts/send-test-email.js",
    "rbac": "node scripts/rbac.js",
    "rbac:setup": "node scripts/rbac.js setup-common",
    "rbac:create-role": "node scripts/create-role.js",
    "rbac:create-permission": "node scripts/create-permission.js",
    "rbac:add-permission-to-role": "node scripts/add-permission-to-role.js",
    "rbac:add-role-to-user": "node scripts/add-role-to-user.js",
    "rbac:list-user-roles": "node scripts/list-user-roles.js",
    "rbac:list-role-permissions": "node scripts/list-role-permissions.js",
    "rbac:set-user-password": "node scripts/set-user-password.js",
    "sso:generate-keys": "node scripts/generate-sso-keys.js",
    "test": "NODE_ENV=test jest --coverage --runInBand",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:verbose": "NODE_ENV=test jest --verbose --runInBand",
    "test:cleanup": "node src/tests/test-db-cleanup.js"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.948.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "joi": "^18.0.2",
    "jose": "^4.15.9",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nanoid": "^3.3.11",
    "nodemailer": "^8.0.6",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-twitter": "^0.1.5",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.0.379",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^5.1.1",
    "typeorm": "^0.3.31",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-boundaries": "^4.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
