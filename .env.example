# =============================================================================
# Copy to .env and edit. Never commit .env.
# =============================================================================

# --- App ---
APP_NAME=Your App
NODE_ENV=development
# Default deployment port for this service. docker-compose binds host:${PORT}.
PORT=5269
# Public URL of this API (OAuth callbacks, email links, local file URLs)
API_BASE_URL=http://localhost:5269
FRONTEND_URL=http://localhost:5270
# Optional: used in some auth email links if set (e.g. Next.js public URL)
# NEXT_PUBLIC_APP_URL=http://localhost:5270
# Institution portal URL: the login link in JUPEB institution emails. Set it when
# institution emails are sent; unset, those emails carry the literal "undefined".
# INSTITUTION_FRONTEND_URL=https://institution.your-domain.com
# Hours an email-verification link stays valid (default 24).
# EMAIL_VERIFICATION_TTL_HOURS=24

# --- Database (required) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=your_app

# --- JWT (required for auth) ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS (required for browser clients) ---
# Comma-separated origins
CORS_ORIGIN=http://localhost:3000

# --- Rate limiting (reserved) ---
# Passed through Docker Compose; not read by application code yet — add middleware if needed.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Logging ---
# LOG_LEVEL sets Winston verbosity (error, warn, info, debug, …). If unset: debug when
# NODE_ENV=development or LOG_DEBUG=true, otherwise info.
LOG_DEBUG=false
LOG_LEVEL=info
# LOG_FORMAT=json
# LOG_DIR=logs
# LOG_MAX_DAYS=14
# LOG_DATE_PATTERN=YYYY-MM-DD

# --- File storage ---
# mock | local | s3 — see src/modules/files/services/file.service.js
DEFAULT_FILE_PROVIDER=s3

# S3-compatible storage (when DEFAULT_FILE_PROVIDER=s3 or for signed URLs)
# Backend: aws | digitalocean
S3_PROVIDER=digitalocean

# AWS S3 (S3_PROVIDER=aws)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Bucket name (AWS_S3_BUCKET is an accepted alias)
AWS_S3_BUCKET_NAME=
AWS_S3_BUCKET=
# Optional CDN/public base URL (works for either provider)
AWS_S3_BUCKET_BASE_URL=

# DigitalOcean Spaces (S3_PROVIDER=digitalocean)
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=
DO_SPACES_ENDPOINT=
DO_SPACES_BUCKET=
# Legacy fallbacks (prefer DO_SPACES_* above for this API)
# NEXT_PUBLIC_DO_SPACES_ACCESS_KEY=
# NEXT_PUBLIC_DO_SPACES_SECRET=
# NEXT_PUBLIC_DO_SPACES_REGION=
# NEXT_PUBLIC_DO_SPACES_ENDPOINT=
# NEXT_PUBLIC_DO_SPACES_BUCKET=

# Storage quota (MB per user; -1 for unlimited)
STORAGE_LIMIT_MB=1024

# --- SMTP (optional — required for real password reset / welcome email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@example.com

# --- Redis (optional — not used by current codebase; reserved for queues/cache) ---
REDIS_URL=redis://localhost:6379

# --- OAuth (optional — leave blank to disable a provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=

# --- Payments (optional — seed payment_methods in DB; keys stored on rows, not here) ---
# Public stats on GET /payments/stats: progress bar denominator (amount in same currency as totals)
# PAYMENT_STATS_MONTHLY_GOAL=1000000
# Flutterwave hosted checkout logo URL (optional)
# FLW_CHECKOUT_LOGO_URL=https://example.com/logo.png
# Direct-transfer instructions email requires SMTP_* and FROM_EMAIL above.
# Remita: merchant id and API key live on the `remita` payment_methods row; the
# service type id comes from here. Required when Remita is enabled.
# REMITA_SERVICE_TYPE_ID=

# --- Posts / comments / SEO / rate limits (optional) ---
# Max nesting depth for replies
# POST_COMMENT_MAX_DEPTH=20
# Honeypot field name — if set and client sends a non-empty value, comment create returns 400 (bots)
# POST_COMMENT_HONEYPOT_FIELD=company_website
# Rate limits (per user_id or IP), window default 60000 ms
# POST_READ_RATE_LIMIT_MAX=120
# POST_WRITE_RATE_LIMIT_MAX=20
# POST_COMMENT_RATE_LIMIT_MAX=25
# POST_LIKE_RATE_LIMIT_MAX=60
# POST_RATE_LIMIT_WINDOW_MS=60000

# --- API docs ---
# If set, /docs requires HTTP Basic auth (password only; username can be anything)
API_DOCS_PASSWORD=

# --- JUPEB (optional) ---
# Hours until a newly generated institution claim code expires. Empty or 0 = no expiry.
# JUPEB_INSTITUTION_CODE_TTL_HOURS=24
# When true, student-facing JUPEB routes (claim, checkout, submissions) allow only student + user roles.
# Default false also allows admin and super_admin for support and tests.
# JUPEB_STUDENT_ROUTES_STRICT=false
# Length of generated institution codes (4–16, default 6).
# JUPEB_INSTITUTION_CODE_LENGTH=6
# When true, submitted subjects must exist in the subject catalog.
# JUPEB_ENFORCE_SUBJECT_CATALOG=false
# Reject face captures whose quality_score is below this (unset or 0 = no check).
# JUPEB_FACE_MIN_QUALITY=
# Seconds a submitted-document download link stays valid (default 300).
# JUPEB_DOC_DOWNLOAD_TTL_SEC=300

# --- JUPEB NIN provider ---
# PRODUCTION: set JUPEB_NIN_PROVIDER=speedysms. Unset — or any unknown name —
# falls back to mock, which does not check NINs against NIMC.
# Which NIN verification provider to use. Registered providers:
#   mock      — in-process fixture; default; never reaches the network. Does NOT
#               query NIMC: any 11-digit NIN (except 00000000000) returns verified
#               unless you enable strict mode below.
#   speedysms — calls SpeedySMS Identity API (POST /identity/nin)
# JUPEB_NIN_PROVIDER=mock
# When mock is active: if 1/true, only NINs 00000000001–00000000010 verify (SpeedySMS
# test-pool parity). Otherwise random 11-digit NINs still "verify" — by design for dev.
# JUPEB_NIN_MOCK_STRICT=1
# Seconds the resolver should wait before retrying when a provider reports unavailable.
# JUPEB_NIN_RETRY_AFTER_SECONDS=300
# Background resolver for NIN checks left pending by an outage: how often it runs
# (ms, default 60000) and how many attempts before it gives up (default 12).
# It runs inside every API process — run one replica, or expect duplicate ticks.
# JUPEB_NIN_RESOLVER_INTERVAL_MS=60000
# JUPEB_NIN_MAX_ATTEMPTS=12
# Tests only: 1 makes every NIN check report "provider unavailable". Never set in production.
# JUPEB_NIN_FORCE_UNAVAILABLE=

# --- SpeedySMS (required when JUPEB_NIN_PROVIDER or OTP_SMS_PROVIDER is speedysms) ---
# SPEEDYSMS_API_KEY=sk_live_your_key
# SPEEDYSMS_API_BASE_URL=https://api.speedysms.com.ng
# SPEEDYSMS_NIN_TIMEOUT_MS=15000
# Signs NIN requests (X-Timestamp / X-Nonce / X-Signature). Unset = unsigned requests;
# set it when the SpeedySMS account has signed requests enabled.
# SPEEDYSMS_SIGNING_SECRET=

# --- OTP (verify-phone / resend-otp) ---
# Channel for /auth/resend-otp dispatch:
#   email — send 6-digit code to users.email (default)
#   sms   — send via the SMS provider registry (see OTP_SMS_PROVIDER)
#   both  — send via both in parallel
# Request body may override with { "channel": "email" | "sms" | "both" }.
# OTP_CHANNEL=email
# Lifetime of the issued code in minutes (default 10).
# OTP_TTL_MINUTES=10
# Which SMS provider answers when the channel resolves to `sms` (or `both`).
# Registered: mock (default; logs to console) | speedysms. Unknown names fall back
# to mock. PRODUCTION with sms/both: set OTP_SMS_PROVIDER=speedysms.
# OTP_SMS_PROVIDER=mock
# Sender ID surfaced to recipients (max 11 chars; gateway-dependent).
# SPEEDYSMS_SENDER_ID=OTP
# Outbound timeout in ms (default 15000).
# SPEEDYSMS_SMS_TIMEOUT_MS=15000

# --- Attendance service (mobile dashboard / attendance screens) ---
# http — calls ATTENDANCE_SERVICE_BASE_URL (default)
# mock — deterministic fixtures, for local runs and tests
# ATTENDANCE_PROVIDER=http
# ATTENDANCE_SERVICE_BASE_URL=https://attendance.example.com
# ATTENDANCE_ADMIN_SECRET=
# ATTENDANCE_APPLICATION_NAME=
# ATTENDANCE_SERVICE_TIMEOUT_MS=15000

# --- CRMS service (mobile courses / JUPEB exam results) ---
# http — calls CRMS_SERVICE_BASE_URL with Bearer API key (default)
# mock — deterministic fixtures, for local runs and tests
# CRMS_PROVIDER=http
# CRMS_SERVICE_BASE_URL=https://crms.example.com
# CRMS_SERVICE_API_KEY=
# CRMS_SERVICE_TIMEOUT_MS=15000

# Seconds until a registration-slip download URL expires (default 900 = 15 min)
# REGISTRATION_SLIP_TTL_SECONDS=900

# --- SSO into CRMS and Attendance (optional) ---
# This API signs RS256 tokens that CRMS and Attendance accept. SSO is on only when
# all four CRP_SSO_* values are set. Generate the keys with:
#   npm run sso:generate-keys            (or: docker compose exec api npm run sso:generate-keys)
# It prints CRP_SSO_CURRENT_KID, CRP_SSO_PRIVATE_KEY_PEM (newlines as \n) and
# CRP_SSO_JWKS_JSON. Keep the private key secret; give the JWKS to CRMS / Attendance.
# CRP_SSO_ISSUER=https://api.your-domain.com
# CRP_SSO_CURRENT_KID=
# CRP_SSO_PRIVATE_KEY_PEM=
# CRP_SSO_JWKS_JSON=
# Where each app receives the SSO token.
# CRMS_SSO_CALLBACK_URL=https://crms.example.com/sso/callback
# ATTENDANCE_SSO_CALLBACK_URL=https://attendance.example.com/sso/callback

# --- OCR (document extraction for JUPEB submissions) ---
# On unless set to false.
# FEATURE_OCR_ENABLED=true
# Providers tried in order: pdf_text | tesseract | ocr_space | mock
# OCR_DEFAULT_CHAIN=pdf_text,tesseract
# Tried when the chain's results fall below OCR_CONFIDENCE_FLOOR (0–100, default 60).
# ocr_space is used only when OCR_SPACE_API_KEY is set.
# OCR_FALLBACK_PROVIDER=ocr_space
# OCR_CONFIDENCE_FLOOR=60
# OCR_MAX_FILE_SIZE_MB=15
# OCR_TESSERACT_LANGS=eng
# OCR_TESSERACT_WORKER_COUNT=2
# OCR_SPACE_API_KEY=
# OCR_SPACE_ENGINE=2
# OCR_SPACE_LANGUAGE=eng
# OCR_PROVIDER_TIMEOUT_MS=25000

# --- Tests only (set by src/tests/setup.js; optional overrides for local test runs) ---
# The app itself does not read these; they only affect the test suite.
# JUPEB_EMAIL_FORCE=1 sends real email under NODE_ENV=test (scripts/check-email.js).
# JUPEB_EMAIL_FORCE=
# USE_MOCK_OTP=true
# MOCK_OTP_CODE=123456
# SKIP_EMAIL_VERIFICATION=true
# SKIP_SMS_VERIFICATION=true
